# Copy this file next to KnLiveDbg.exe (the EXE directory), not the repo root.
# Then: ai use cloud
# List/search models: ai models    Refresh live OpenRouter ids: ai models refresh

KNLIVEDBG_AI_PROVIDER=openrouter
KNLIVEDBG_AI_REMOTE_POLICY=allow-remote
KNLIVEDBG_OPENROUTER_API_KEY=sk-or-replace-me

# Optional. cloud default is anthropic/claude-opus-5 (frontier as of 2026-08-24).
# KNLIVEDBG_AI_MODEL=anthropic/claude-opus-5
# Cheap OpenRouter option:
# KNLIVEDBG_AI_MODEL=openai/gpt-oss-120b

# For DeepSeek native instead:
# KNLIVEDBG_AI_PROVIDER=deepseek
# KNLIVEDBG_AI_MODEL=deepseek-chat
# KNLIVEDBG_DEEPSEEK_API_KEY=sk-replace-me

# Optional provider overrides:
# Use local-only to block HTTP-backed providers in private sessions.
# KNLIVEDBG_AI_REMOTE_POLICY=local-only
# KNLIVEDBG_AI_BASE_URL=https://openrouter.ai/api/v1
# KNLIVEDBG_AI_REASONING_EFFORT=medium
# KNLIVEDBG_AI_TIMEOUT_SECONDS=120

# Optional Codex paths:
# KNLIVEDBG_CODEX_CLI_PATH=codex
# KNLIVEDBG_CODEX_AUTH_FILE=%USERPROFILE%\.codex\auth.json
